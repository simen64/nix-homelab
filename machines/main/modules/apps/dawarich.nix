{
  pkgs,
  lib,
  config,
  ...
}: {
  clan.core.vars.generators.dawarich = {
    prompts.OIDC_CLIENT_SECRET = {
      description = "OIDC_CLIENT_SECRET";
      type = "hidden";
    };
    files.dawarich = {
      secret = true;
    };
    script = ''
      echo "OIDC_CLIENT_SECRET=$(cat $prompts/OIDC_CLIENT_SECRET)" > $out/dawarich
    '';
  };

  # Runtime
  virtualisation.podman = {
    enable = true;
    autoPrune.enable = true;
    dockerCompat = true;
  };

  # Enable container name DNS for all Podman networks.
  networking.firewall.interfaces = let
    matchAll =
      if !config.networking.nftables.enable
      then "podman+"
      else "podman*";
  in {
    "${matchAll}".allowedUDPPorts = [53];
  };

  virtualisation.oci-containers.backend = "podman";

  # Reverse geocode containers
  virtualisation.oci-containers.containers."photon" = {
    image = "docker.io/rtuszik/photon-docker:latest";

    environment = {
      # Europe includes Norway and the rest of Europe.
      "REGION" = "europe";
      "UPDATE_STRATEGY" = "PARALLEL";
      "UPDATE_INTERVAL" = "720h";
    };

    volumes = [
      "photon_data:/photon/data:rw"
    ];

    extraOptions = [
      "--network-alias=photon"
      "--network=darawich_dawarich"
    ];

    log-driver = "journald";
  };

  systemd.services."podman-photon" = {
    serviceConfig.Restart = lib.mkOverride 90 "always";

    unitConfig.Description = "Photon reverse geocoding service";

    after = [
      "podman-network-darawich_dawarich.service"
      "podman-volume-photon_data.service"
    ];

    requires = [
      "podman-network-darawich_dawarich.service"
      "podman-volume-photon_data.service"
    ];

    partOf = [
      "podman-compose-darawich-root.target"
    ];

    wantedBy = [
      "podman-compose-darawich-root.target"
    ];
  };

  systemd.services."podman-volume-photon_data" = {
    unitConfig.Description = "Persistent Photon index volume";

    path = [pkgs.podman];

    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };

    script = ''
      podman volume inspect photon_data ||
        podman volume create photon_data
    '';

    partOf = [
      "podman-compose-darawich-root.target"
    ];

    wantedBy = [
      "podman-compose-darawich-root.target"
    ];
  };

  # Containers
  virtualisation.oci-containers.containers."dawarich_app" = {
    image = "docker.io/freikin/dawarich:latest";
    environmentFiles = [
      config.clan.core.vars.generators.dawarich.files.dawarich.path
    ];
    environment = {
      "OIDC_CLIENT_ID" = "f7b2d7fb-672b-4ad6-b0f0-73e4c65413be";
      "OIDC_ISSUER" = "https://pocket-id.simenmo.com";
      "OIDC_REDIRECT_URI" = "https://dawarich.vpn.simenmo.com/users/auth/openid_connect/callback";
      "OIDC_PROVIDER_NAME" = "Pocket-id";
      "OIDC_PKCE_ENABLED" = "true";
      "ALLOW_EMAIL_PASSWORD_LOGIN" = "false";
      "APPLICATION_HOSTS" = "localhost,::1,127.0.0.1,dawarich.simenmo.com,dawarich.vpn.simenmo.com,100.123.23.198";
      "APPLICATION_PROTOCOL" = "https";
      "DATABASE_HOST" = "dawarich_db";
      "DATABASE_NAME" = "dawarich_development";
      "DATABASE_PASSWORD" = "password";
      "DATABASE_PORT" = "5432";
      "DATABASE_USERNAME" = "postgres";
      "PROMETHEUS_EXPORTER_ENABLED" = "false";
      "RAILS_ENV" = "production";
      "RAILS_LOG_TO_STDOUT" = "true";
      "REDIS_URL" = "redis://dawarich_redis:6379";
      "SECRET_KEY_BASE" = "\"CHANGE_ME\"";
      "SELF_HOSTED" = "true";
      "STORE_GEODATA" = "true";
      "TIME_ZONE" = "Europe/Oslo";
      "WEB_CONCURRENCY" = "1";
      "PHOTON_API_HOST" = "photon:2322";
      "PHOTON_API_USE_HTTPS" = "false";
    };
    volumes = [
      "darawich_dawarich_db_data:/dawarich_db_data:rw"
      "darawich_dawarich_public:/var/app/public:rw"
      "darawich_dawarich_storage:/var/app/storage:rw"
      "darawich_dawarich_watched:/var/app/tmp/imports/watched:rw"
    ];
    ports = [
      "0.0.0.0:3005:3000/tcp"
    ];
    cmd = ["bin/rails" "server" "-p" "3000" "-b" "::"];
    dependsOn = [
      "dawarich_db"
      "dawarich_redis"
    ];
    log-driver = "journald";
    extraOptions = [
      "--cpus=0.5"
      "--entrypoint=[\"web-entrypoint.sh\"]"
      "--health-cmd=wget -qO - http://127.0.0.1:3000/api/v1/health | grep -q '\"status\"\\s*:\\s*\"ok\"'"
      "--health-interval=10s"
      "--health-retries=30"
      "--health-start-period=30s"
      "--health-timeout=10s"
      "--memory=4294967296b"
      "--network-alias=dawarich_app"
      "--network=darawich_dawarich"
    ];
  };
  systemd.services."podman-dawarich_app" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container dawarich_app generated by compose2nix.";
    after = [
      "podman-network-darawich_dawarich.service"
      "podman-volume-darawich_dawarich_db_data.service"
      "podman-volume-darawich_dawarich_public.service"
      "podman-volume-darawich_dawarich_storage.service"
      "podman-volume-darawich_dawarich_watched.service"
    ];
    requires = [
      "podman-network-darawich_dawarich.service"
      "podman-volume-darawich_dawarich_db_data.service"
      "podman-volume-darawich_dawarich_public.service"
      "podman-volume-darawich_dawarich_storage.service"
      "podman-volume-darawich_dawarich_watched.service"
    ];
    partOf = [
      "podman-compose-darawich-root.target"
    ];
    wantedBy = [
      "podman-compose-darawich-root.target"
    ];
  };
  virtualisation.oci-containers.containers."dawarich_db" = {
    image = "docker.io/postgis/postgis:17-3.5-alpine";
    environment = {
      "POSTGRES_DB" = "dawarich_development";
      "POSTGRES_PASSWORD" = "password";
      "POSTGRES_USER" = "postgres";
    };
    volumes = [
      "darawich_dawarich_db_data:/var/lib/postgresql/data:rw"
      "darawich_dawarich_shared:/var/shared:rw"
    ];
    log-driver = "journald";
    extraOptions = [
      "--health-cmd=pg_isready -U postgres -d dawarich_development"
      "--health-interval=10s"
      "--health-retries=5"
      "--health-start-period=30s"
      "--health-timeout=10s"
      "--network-alias=dawarich_db"
      "--network=darawich_dawarich"
      "--shm-size=1073741824"
    ];
  };
  systemd.services."podman-dawarich_db" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container dawarich_db generated by compose2nix.";
    after = [
      "podman-network-darawich_dawarich.service"
      "podman-volume-darawich_dawarich_db_data.service"
      "podman-volume-darawich_dawarich_shared.service"
    ];
    requires = [
      "podman-network-darawich_dawarich.service"
      "podman-volume-darawich_dawarich_db_data.service"
      "podman-volume-darawich_dawarich_shared.service"
    ];
    partOf = [
      "podman-compose-darawich-root.target"
    ];
    wantedBy = [
      "podman-compose-darawich-root.target"
    ];
  };
  virtualisation.oci-containers.containers."dawarich_redis" = {
    image = "docker.io/redis:7.4-alpine";
    volumes = [
      "darawich_dawarich_shared:/data:rw"
    ];
    cmd = ["redis-server" "--save" "900" "1" "--save" "300" "10" "--appendonly" "no"];
    log-driver = "journald";
    extraOptions = [
      "--health-cmd=[\"redis-cli\", \"--raw\", \"incr\", \"ping\"]"
      "--health-interval=10s"
      "--health-retries=5"
      "--health-start-period=30s"
      "--health-timeout=10s"
      "--network-alias=dawarich_redis"
      "--network=darawich_dawarich"
    ];
  };
  systemd.services."podman-dawarich_redis" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container dawarich_redis generated by compose2nix.";
    after = [
      "podman-network-darawich_dawarich.service"
      "podman-volume-darawich_dawarich_shared.service"
    ];
    requires = [
      "podman-network-darawich_dawarich.service"
      "podman-volume-darawich_dawarich_shared.service"
    ];
    partOf = [
      "podman-compose-darawich-root.target"
    ];
    wantedBy = [
      "podman-compose-darawich-root.target"
    ];
  };
  virtualisation.oci-containers.containers."dawarich_sidekiq" = {
    image = "docker.io/freikin/dawarich:latest";
    environmentFiles = [
      config.clan.core.vars.generators.dawarich.files.dawarich.path
    ];
    environment = {
      "OIDC_CLIENT_ID" = "f7b2d7fb-672b-4ad6-b0f0-73e4c65413be";
      "OIDC_ISSUER" = "https://pocket-id.simenmo.com";
      "OIDC_REDIRECT_URI" = "https://dawarich.vpn.simenmo.com/users/auth/openid_connect/callback";
      "OIDC_PROVIDER_NAME" = "Pocket-id";
      "OIDC_PKCE_ENABLED" = "true";
      "ALLOW_EMAIL_PASSWORD_LOGIN" = "false";
      "APPLICATION_HOSTS" = "dawarich.simenmo.com,localhost,::1,127.0.0.1,dawarich.vpn.simenmo.com,100.123.23.198";
      "APPLICATION_PROTOCOL" = "http";
      "BACKGROUND_PROCESSING_CONCURRENCY" = "3";
      "DATABASE_HOST" = "dawarich_db";
      "DATABASE_NAME" = "dawarich_development";
      "DATABASE_PASSWORD" = "password";
      "DATABASE_PORT" = "5432";
      "DATABASE_USERNAME" = "postgres";
      "PROMETHEUS_EXPORTER_ENABLED" = "false";
      "RAILS_ENV" = "production";
      "RAILS_LOG_TO_STDOUT" = "true";
      "REDIS_URL" = "redis://dawarich_redis:6379";
      "SECRET_KEY_BASE" = "\"CHANGE_ME\"";
      "SELF_HOSTED" = "true";
      "STORE_GEODATA" = "true";
      "PHOTON_API_HOST" = "photon:2322";
      "PHOTON_API_USE_HTTPS" = "false";
    };
    volumes = [
      "darawich_dawarich_public:/var/app/public:rw"
      "darawich_dawarich_storage:/var/app/storage:rw"
      "darawich_dawarich_watched:/var/app/tmp/imports/watched:rw"
    ];
    cmd = ["sidekiq"];
    dependsOn = [
      "dawarich_app"
      "dawarich_db"
      "dawarich_redis"
    ];
    log-driver = "journald";
    extraOptions = [
      "--entrypoint=[\"sidekiq-entrypoint.sh\"]"
      "--health-cmd=pgrep -f sidekiq"
      "--health-interval=10s"
      "--health-retries=30"
      "--health-start-period=30s"
      "--health-timeout=10s"
      "--network-alias=dawarich_sidekiq"
      "--network=darawich_dawarich"
    ];
  };
  systemd.services."podman-dawarich_sidekiq" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container dawarich_sidekiq generated by compose2nix.";
    after = [
      "podman-network-darawich_dawarich.service"
      "podman-volume-darawich_dawarich_public.service"
      "podman-volume-darawich_dawarich_storage.service"
      "podman-volume-darawich_dawarich_watched.service"
    ];
    requires = [
      "podman-network-darawich_dawarich.service"
      "podman-volume-darawich_dawarich_public.service"
      "podman-volume-darawich_dawarich_storage.service"
      "podman-volume-darawich_dawarich_watched.service"
    ];
    partOf = [
      "podman-compose-darawich-root.target"
    ];
    wantedBy = [
      "podman-compose-darawich-root.target"
    ];
  };

  # Networks
  systemd.services."podman-network-darawich_dawarich" = {
    unitConfig.Description = "Network darawich_dawarich generated by compose2nix.";
    path = [pkgs.podman];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "podman network rm -f darawich_dawarich";
    };
    script = ''
      podman network inspect darawich_dawarich || podman network create darawich_dawarich
    '';
    partOf = ["podman-compose-darawich-root.target"];
    wantedBy = ["podman-compose-darawich-root.target"];
  };

  # Volumes
  systemd.services."podman-volume-darawich_dawarich_db_data" = {
    unitConfig.Description = "Volume darawich_dawarich_db_data generated by compose2nix.";
    path = [pkgs.podman];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect darawich_dawarich_db_data || podman volume create darawich_dawarich_db_data
    '';
    partOf = ["podman-compose-darawich-root.target"];
    wantedBy = ["podman-compose-darawich-root.target"];
  };
  systemd.services."podman-volume-darawich_dawarich_public" = {
    unitConfig.Description = "Volume darawich_dawarich_public generated by compose2nix.";
    path = [pkgs.podman];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect darawich_dawarich_public || podman volume create darawich_dawarich_public
    '';
    partOf = ["podman-compose-darawich-root.target"];
    wantedBy = ["podman-compose-darawich-root.target"];
  };
  systemd.services."podman-volume-darawich_dawarich_shared" = {
    unitConfig.Description = "Volume darawich_dawarich_shared generated by compose2nix.";
    path = [pkgs.podman];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect darawich_dawarich_shared || podman volume create darawich_dawarich_shared
    '';
    partOf = ["podman-compose-darawich-root.target"];
    wantedBy = ["podman-compose-darawich-root.target"];
  };
  systemd.services."podman-volume-darawich_dawarich_storage" = {
    unitConfig.Description = "Volume darawich_dawarich_storage generated by compose2nix.";
    path = [pkgs.podman];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect darawich_dawarich_storage || podman volume create darawich_dawarich_storage
    '';
    partOf = ["podman-compose-darawich-root.target"];
    wantedBy = ["podman-compose-darawich-root.target"];
  };
  systemd.services."podman-volume-darawich_dawarich_watched" = {
    unitConfig.Description = "Volume darawich_dawarich_watched generated by compose2nix.";
    path = [pkgs.podman];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect darawich_dawarich_watched || podman volume create darawich_dawarich_watched
    '';
    partOf = ["podman-compose-darawich-root.target"];
    wantedBy = ["podman-compose-darawich-root.target"];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."podman-compose-darawich-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = ["multi-user.target"];
  };
}
